  "firestore": {
    "/users/{userId}/data_siswa/{siswaId}": {
      "schema": { "$ref": "#/entities/data_siswa" },
      "description": "Koleksi master data siswa milik guru"
    },
    "/users/{userId}/mapel/{mapelId}": {
      "schema": { "$ref": "#/entities/mapel" },
      "description": "Koleksi daftar mata pelajaran milik guru"
    },
    "/users/{userId}/jadwal/{jadwalId}": {
      "schema": { "$ref": "#/entities/jadwal" },
      "description": "Koleksi jadwal mengajar guru"
    },
    "/users/{userId}/log_absensi/{absensiId}": {
      "schema": { "$ref": "#/entities/log_absensi" },
      "description": "Koleksi log presensi harian siswa"
    },
    "/users/{userId}/data_nilai/{nilaiId}": {
      "schema": { "$ref": "#/entities/data_nilai" },
      "description": "Koleksi nilai akademik siswa"
    },
    "/users/{userId}/jurnal_agenda/{agendaId}": {
      "schema": { "$ref": "#/entities/jurnal_agenda" },
      "description": "Koleksi jurnal agenda mengajar harian"
    },
    "/users/{userId}/siswa_bimbingan/{siswaBimbinganId}": {
      "schema": { "$ref": "#/entities/siswa_bimbingan" },
      "description": "Koleksi daftar siswa perwalian guru wali"
    },
    "/users/{userId}/bimbingan_wali/{bimbinganId}": {
      "schema": { "$ref": "#/entities/bimbingan_wali" },
      "description": "Koleksi catatan bimbingan dan konseling guru wali"
    },
    "/users/{userId}/pengaturan/{configId}": {
      "schema": { "$ref": "#/entities/pengaturan" },
      "description": "Dokumen tunggal pengaturan profil dan kop surat guru (config)"
    }
  }
