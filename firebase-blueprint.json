        "jam": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "mapel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "userUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
