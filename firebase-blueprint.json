{
  "entities": {
    "data_siswa": {
      "title": "Data Siswa",
      "description": "Master Data Siswa milik guru untuk presensi, penilaian, dan cetak kartu pelajar",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nisn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "userUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "nisn", "nama", "kelas", "userUid", "updatedAt"]
    },
    "mapel": {
      "title": "Mata Pelajaran",
      "description": "Master Mata Pelajaran yang diampu guru per semester dan tahun ajaran",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "namaMapel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "semester": {
          "type": "string",
          "enum": ["Ganjil", "Genap"],
          "maxLength": 30
        },
        "tahunAjaran": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "userUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "namaMapel", "semester", "tahunAjaran", "userUid", "updatedAt"]
    },
    "jadwal": {
      "title": "Jadwal Mengajar",
